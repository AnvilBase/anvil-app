// Copy to Config/Local.xcconfig (git ignores it) and fill in what you need. Run
// Scripts/bootstrap.sh to do the copying for you. Nothing here is required to build.

// Your Apple Developer team, from Xcode › Settings › Accounts. Without it, pick your team once in
// Signing & Capabilities and Xcode stores it in your own workspace instead.
// DEVELOPMENT_TEAM = ABCDE12345

// Bundle identifiers must be unique to you when signing with a free Apple ID.
// ANVIL_BUNDLE_PREFIX = com.yourname

// Optional. Web search works without a key: queries go through anvilai.com, which holds Anvil's own
// Brave Search key. Put your own here (https://api-dashboard.search.brave.com) to call Brave directly
// instead. Anyone with a copy of a build can extract a key compiled into it, so don't share builds
// that carry yours, and set a monthly limit in Brave's dashboard.
// ANVIL_BRAVE_API_KEY = your-key-here

// Free Apple IDs can't sign the increased-memory-limit capability. Uncomment to build without it,
// then lower Settings › Model › Context size if iOS closes the app while the model loads.
// ANVIL_ENTITLEMENTS =

// Where anvilai.com is, as a host (an xcconfig reads // as a comment, so it can't be a full URL).
// The app reads models from /api/models and searches through /api/search there, the same routes
// https://github.com/AnvilBase/anvil-site serves. Leave it alone to use Anvil's.
// ANVIL_HOST = anvil.example.com
