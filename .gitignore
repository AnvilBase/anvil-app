# Model files are copied onto the phone separately and are far too large for git.
*.litertlm
*.gguf
*.task

# Queued tasks for claude-queue. Local scratch, and it names files after the task text, so anything
# pasted into /q — a key, a token — would otherwise land in the repository as a filename.
.claude-queue/
